# Optional Gemini API Configuration
# Get a key from https://aistudio.google.com/ if you wish to use Gemini cloud generation.
# If omitted, the application runs entirely locally using Ollama (gemma3:latest).
GEMINI_API_KEY=
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=gemma3:latest

# Embeddings & NLI Model Configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
NLI_MODEL_NAME=roberta-large-mnli
USE_CUDA=false

# RAG & Verification Parameters
CHUNK_SIZE=450
CHUNK_OVERLAP=80
TOP_K_RETRIEVAL=4
ENTAILMENT_THRESHOLD=0.50
CONTRADICTION_THRESHOLD=0.50
AMBIGUITY_THRESHOLD=0.15
